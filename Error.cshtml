@{ ViewData["Title"] = "Error"; }
<section class="card-panel text-center py-5">
    <h1 class="h3">@(ViewBag.Code == 404 ? "No encontramos esa página" : "Algo salió mal")</h1>
    <p class="text-muted">
        @(ViewBag.Code == 404 ? "Revise la dirección o regrese al inicio." : "Intente de nuevo. Si el problema continúa, contacte a soporte e indique este código:")
    </p>
    @if (ViewBag.Code != 404) { <code>@ViewBag.RequestId</code> }
    <div class="mt-4"><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a></div>
</section>
