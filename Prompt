        protected void CustomValidator_ServerValidate(object source, ServerValidateEventArgs args)
        {
            bool questionvalidation = true;
            bool optional65itemSelected = false;
            bool optional70itemSelected = false;

            if (validemployee.InnerText == "Si")
            {
                foreach (Control control in QuestionsPlaceholder.Controls)
                {
                    if (control is Panel questionPanel)
                    {
                        bool answered = false;
                        string questionId = string.Empty;

                        foreach (Control childControl in questionPanel.Controls)
                        {
                            if (childControl is RadioButton radioButton)
                            {
                                questionId = radioButton.GroupName.Split('_')[1];
                                if (radioButton.Checked)
                                {
                                    answered = true;

                                    if (questionId == "65" )
                                    {
                                        optional65itemSelected = true;
                                    }
                                    if (questionId == "70" )
                                    {
                                        optional70itemSelected = true;
                                    }
                                    break;
                                }
                            }
                        }

                        if (!answered)
                        {
                            if (questionId == "66" || questionId == "67" || questionId == "68" || questionId == "69")
                            {
                                if (optional65itemSelected)
                                {
                                    questionvalidation = false;
                                    break;
                                }
                            }
                            else if (questionId == "71" || questionId == "72" || questionId == "73" || questionId == "74")
                            {
                                if (optional70itemSelected)
                                {
                                    questionvalidation = false;
                                    break;
                                }
                            }
                            else
                            {
                                questionvalidation = false;
                                break;
                            }
                        }
                    }
                }
            }
            else
            {
                questionvalidation = false;
            }

            args.IsValid = questionvalidation;
            if (!questionvalidation)
            {
                CustomValidator.ErrorMessage = "Por favor, responda todas las preguntas obligatorias.";
            }
        }
    }


    public static class HelperFunctions
    {
        public static HashSet<string> GetRadioButtonGroup(this ControlCollection collection)
        {
            HashSet<string> questionnumber = new HashSet<string>();
                foreach (var control in collection)
                {
                    if (control is HtmlInputRadioButton)
                    {
                        var radioControl = ((HtmlInputRadioButton)control);
                        questionnumber.Add(radioControl.Name);
                    }
                }

                return new HashSet<string>(questionnumber);
        }

        public static bool PingHost(string nameOrAddress)
        {
            bool pingable = false;
            Ping pinger = null;

            try
            {
                pinger = new Ping();
                PingReply reply = pinger.Send(nameOrAddress);
                pingable = reply.Status == IPStatus.Success;
            }
            catch (PingException e)
            {
                ExceptionUtility.LogException(e, "PingHost in HelperFunctions class - MAHLESurvey.aspx");
                return false;
            }
            finally
            {
                if (pinger != null)
                {
                    pinger.Dispose();
                }
            }
            return pingable;
        }

    }
