        private void GenerateSurveyQuestions(List<SurveyQuestion> questions)
        {
            foreach (var question in questions)
            {
                // Crear un contenedor para cada pregunta
                Panel questionPanel = new Panel();
                questionPanel.CssClass = "question";

                // Crear un label para la pregunta
                Label questionLabel = new Label();
                questionLabel.Text = question.Pregunta;
                questionPanel.Controls.Add(questionLabel);

                // Crear los radio buttons para las respuestas
                foreach (var answer in question.Respuestas)
                {
                    RadioButton radioButton = new RadioButton();
                    radioButton.GroupName = $"question_{question.Id}";
                    radioButton.Text = answer.Texto;
                    radioButton.Attributes["data-valor"] = answer.Valor.ToString();
                    radioButton.ID = $"question_{question.Id}_{answer.Valor}";
                    questionPanel.Controls.Add(radioButton);
                }

                // Agregar el panel de la pregunta al contenedor principal
                QuestionsPlaceholder.Controls.Add(questionPanel);
            }
        }

        public List<SurveyQuestion> GetSurveyQuestions(string anexo)
        {
            List<SurveyQuestion> questions = new List<SurveyQuestion>();
            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                conn.Open();
                string query = @"
            SELECT q.id, q.Pregunta, q.Identificador, rv.ValorSiempre, rv.ValorCasiSiempre, rv.ValorAlgunasVeces, rv.ValorCasiNunca, rv.ValorNunca
            FROM SurveyQuestions q
            LEFT JOIN ResponseValues rv ON q.Identificador = rv.IdentificadorPregunta
            WHERE q.Anexo = @Anexo";

                SqlCommand cmd = new SqlCommand(query, conn);
                cmd.Parameters.AddWithValue("@Anexo", anexo);

                using (SqlDataReader reader = cmd.ExecuteReader())
                {
                    while (reader.Read())
                    {
                        SurveyQuestion question = new SurveyQuestion
                        {
                            Id = reader.GetInt32(0),
                            Pregunta = reader.GetString(1),
                            Identificador = reader.GetString(2),
                            Respuestas = new List<SurveyAnswer>
                    {
                        new SurveyAnswer { Texto = "Siempre", Valor = reader.GetInt32(3) },
                        new SurveyAnswer { Texto = "Casi siempre", Valor = reader.GetInt32(4) },
                        new SurveyAnswer { Texto = "Algunas veces", Valor = reader.GetInt32(5) },
                        new SurveyAnswer { Texto = "Casi nunca", Valor = reader.GetInt32(6) },
                        new SurveyAnswer { Texto = "Nunca", Valor = reader.GetInt32(7) }
                    }
                        };

                        questions.Add(question);
                    }
                }
            }

            return questions;
        }

