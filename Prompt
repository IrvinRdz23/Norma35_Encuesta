            }
        }

        private int GetColumnNumber(string cellReference)
        {
            string columnReference = Regex.Replace(cellReference, @"[\d]", string.Empty);
            int columnNumber = 0;
            int multiplier = 1;

            for (int i = columnReference.Length - 1; i >= 0; i--)
            {
                columnNumber += (columnReference[i] - 'A' + 1) * multiplier;
                multiplier *= 26;
            }
            return columnNumber;
        }
    }           
