        public SharedStringItem GetSharedStringItemById(
            WorkbookPart workbookPart,
            int id)
        {
            if (workbookPart.SharedStringTablePart == null)
            {
                return null;
            }

            return workbookPart
                .SharedStringTablePart
                .SharedStringTable
                .Elements<SharedStringItem>()
                .ElementAtOrDefault(id);
        }

        public string ExcelCellValue(SharedStringItem sharedStringItem)
        {
            if (sharedStringItem == null)
            {
                return string.Empty;
            }

            if (sharedStringItem.Text != null)
            {
                return sharedStringItem.Text.Text;
            }

            if (!string.IsNullOrEmpty(sharedStringItem.InnerText))
            {
                return sharedStringItem.InnerText;
            }

            return string.Empty;
        }

        private int GetColumnNumber(string cellReference)
        {
            string columnReference = Regex.Replace(
                cellReference,
                @"[\d]",
                string.Empty
            );

            int columnNumber = 0;
            int multiplier = 1;

            for (int i = columnReference.Length - 1; i >= 0; i--)
            {
                columnNumber +=
                    (columnReference[i] - 'A' + 1) * multiplier;

                multiplier *= 26;
            }

            return columnNumber;
        }
    }
