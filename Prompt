        protected List<HtmlInputRadioButton> GetRadioButtonsByGroupName(Control parentControl, string groupName)
        {
            List<HtmlInputRadioButton> result = new List<HtmlInputRadioButton>();
            GetRadioButtonsByGroupName(parentControl, groupName, result);
            return result;
        }

        protected void GetRadioButtonsByGroupName(Control parentControl, string groupName, List<HtmlInputRadioButton> list)
        {
            foreach (Control c in parentControl.Controls)
            {
                if (c is HtmlInputRadioButton && ((HtmlInputRadioButton)c).Name.Equals(groupName))
                {
                    list.Add(c as HtmlInputRadioButton);
                }
                else if (c.HasControls())
                {
                    GetRadioButtonsByGroupName(c, groupName, list);
                }
            }
        }

