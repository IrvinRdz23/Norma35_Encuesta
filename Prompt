            string password = "dl0capp";
            string connectionString = "Data Source=" + dataSource + ";Database=" + dataBase + ";User=" + user + ";Password=" + password + ";Connection Timeout=3";
            string TableName = "dbo.SurveyResults";

            if (FileUpload1.HasFile && Path.GetExtension(FileUpload1.FileName) == ".xlsx" | Path.GetExtension(FileUpload1.FileName) == ".xls")
