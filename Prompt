                    using (SpreadsheetDocument spreadsheetDocument = SpreadsheetDocument.Open(filePath, false))
                    {
                        WorkbookPart workbookPart = spreadsheetDocument.WorkbookPart;
                        WorksheetPart worksheetPart = workbookPart.WorksheetParts.First();
                        SheetData sheetData = worksheetPart.Worksheet.Elements<SheetData>().First();

                        SqlConnection connection = new SqlConnection(connectionString); 
                        bool pingdatabase = false;

                        if (dataSource == "mxchjrz-db11x")
                        {
                            pingdatabase = true;
                        }
                        else if (HelperFunctions.PingHost(dataSource))
                        {
                            pingdatabase = true;
                        }
                        else
                        {
                            pingdatabase = false;
                        }
                        if (pingdatabase == true)
                        {

                            if (connection.State == ConnectionState.Closed)
                            {
                                connection.Open();
                            }

                            // Loop through each row in the Excel sheet
                            foreach (Row row in sheetData.Elements<Row>())
                            {
                                DateTime currentDateTime = DateTime.Now;
                                uint rowIndex = row.RowIndex;
                                string fechaAct = currentDateTime.ToString("yyyy-MM-dd HH:mm:ss.fff");
                                string anexoID = "3";
                                string employeeID;
                                string answerString;

                                if (rowIndex == 1) 
                                {
                                    columnsInFile = 82; // row.Count();
                                    continue; 
                                }

                                Cell cellEmployee = row.Elements<Cell>().FirstOrDefault(c => GetColumnNumber(c.CellReference.Value) == 3);
                                if (cellEmployee == null)
                                {
                                    break;
                                }
                                employeeID = cellEmployee.InnerText;

                                //Loop through the question-answer pairs for the current employee
                                for (int questionIndex = 10; questionIndex < columnsInFile; questionIndex++)
                                {
                                    // Extract question number and answer based on the column index
                                    int questionNumber = questionIndex - 9;
                                    Cell cellQuestion = row.Elements<Cell>().FirstOrDefault(q => GetColumnNumber(q.CellReference.Value) == questionIndex);
                                    
                                    int answerInteger = 0;
                                    
                                    if (cellQuestion == null)
                                    {
                                        answerInteger = 0;
                                    }
                                    else
                                    {
                                        answerString = ExcelCellValue(GetSharedStringItemById(workbookPart, int.Parse(cellQuestion.InnerText)));

                                        switch (answerString)
                                        {
                                            case "Siempre":
                                                answerInteger = 1;
                                                break;
                                            case "Casi siempre":
                                                answerInteger = 2;
                                                break;
                                            case "Algunas veces":
                                                answerInteger = 3;
                                                break;
                                            case "Casi nunca":
                                                answerInteger = 4;
                                                break;
                                            case "Nunca":
                                                answerInteger = 5;
                                                break;
                                            case "Si":
                                                answerInteger = 6;
                                                break;
                                            case "No":
                                                answerInteger = 7;
                                                break;
                                            case "Si ( Continua con las preguntas siguientes)":
                                                answerInteger = 6;
                                                break;
                                            case "No ( Pasa a la siguiente sección)":
                                                answerInteger = 7;
                                                questionIndex += 4;
                                                break;
                                            case "Sí (Continue con el cuestionario)":
                                                answerInteger = 6;
                                                break;
                                            case "No ( Has concluido el cuestionario)":
                                                answerInteger = 7;
                                                questionIndex += 4;
                                                break;
                                        }
                                    }
                                    
                                    //check if the record already exist
                                    string selectQuery = "SELECT COUNT(*) FROM " + TableName + " WHERE NumeroReloj = @employeeID AND IdentificadorPregunta = @questionNumber";

                                    using (SqlCommand selectCommand = new SqlCommand(selectQuery, connection))
                                    {
                                        selectCommand.Parameters.AddWithValue("@employeeID", employeeID);
                                        selectCommand.Parameters.AddWithValue("@questionNumber", "question[" + questionNumber + "]");

                                        int existingRecordCount = (int)selectCommand.ExecuteScalar();
                                        if (existingRecordCount > 0)
                                        {
                                            //Update existing records
                                            string updateQuery = "UPDATE " + TableName + " SET IdentificadorRespuesta = @answerInteger, FechaActualizacion = @fechaAct WHERE NumeroReloj = @employeeID AND IdentificadorPregunta = @questionNumber";

                                            using (SqlCommand updateCommand = new SqlCommand(updateQuery, connection))
                                            {
                                                updateCommand.Parameters.AddWithValue("@answerInteger", answerInteger);
                                                updateCommand.Parameters.AddWithValue("@employeeID", employeeID);
                                                updateCommand.Parameters.AddWithValue("@fechaAct", fechaAct);
                                                updateCommand.Parameters.AddWithValue("@questionNumber", "question[" + questionNumber + "]");
                                                //updateCommand.ExecuteNonQuery();
                                            }
                                        }
                                        else
                                        {
                                            string insertQuery = "INSERT INTO " + TableName + " (NumeroReloj, IdentificadorPregunta, IdentificadorRespuesta, FechaActualizacion, Anexo) VALUES (@employeeID, @questionNumber, @answerInteger, @fechaAct, @anexoId)";

                                            using (SqlCommand insertCommand = new SqlCommand(insertQuery, connection))
                                            {
                                                insertCommand.Parameters.AddWithValue("@answerInteger", answerInteger);
                                                insertCommand.Parameters.AddWithValue("@employeeID", employeeID);
                                                insertCommand.Parameters.AddWithValue("@questionNumber", "question[" + questionNumber + "]");
                                                insertCommand.Parameters.AddWithValue("@fechaAct", fechaAct);
                                                insertCommand.Parameters.AddWithValue("@anexoID", anexoID);
